  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area         Area?        @relation(fields: [areaId], references: [id])
  community    Community?   @relation(fields: [communityId], references: [id])
  developer    Developer?   @relation(fields: [developerId], references: [id])

  @@unique([organizationId, source, externalId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, source])
  @@index([deletedAt])
  @@map("faqs")
}

model Menu {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  location       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([organizationId, location])
  @@index([deletedAt])
  @@map("menus")
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  parentId  String?
  label     String
  href      String?
  target    String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuTree")

  @@index([menuId, sortOrder])
