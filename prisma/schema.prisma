// -----------------------------------------------------------------------------
// Form builder
// -----------------------------------------------------------------------------

model Form {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  successMessage String?
  submitLabel    String?  @default("Submit")
  isActive       Boolean  @default(true)
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fields       FormField[]
  submissions  FormSubmission[]
  leads        Lead[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([deletedAt])
  @@map("forms")
}

model FormField {
  id         String        @id @default(cuid())
  formId     String
  name       String
  label      String
  type       FormFieldType
  placeholder String?
  helpText   String?
  options    Json?
  validation Json?
  isRequired Boolean       @default(false)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, name])
  @@index([formId, sortOrder])
  @@index([deletedAt])
  @@map("form_fields")
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  payload   Json
  leadId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([deletedAt])
  @@map("form_submissions")
}

// -----------------------------------------------------------------------------
// Workflow / approvals
// -----------------------------------------------------------------------------

model WorkflowAction {
  id         String            @id @default(cuid())
  entityType ContentEntityType
  entityId   String
  fromState  WorkflowState?
  toState    WorkflowState
  comment    String?
  actorId    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([deletedAt])
  @@map("workflow_actions")
}

/**
 * One thing waiting for a reviewer. CREATE rows point at a record that is
 * already stored but kept out of public view; UPDATE rows hold the proposed
 * changes in `payload` so the live version stays untouched until approval.
 */
model ContentSubmission {
  id             String            @id @default(cuid())
  organizationId String
  entityType     ContentEntityType
  /// Null for access requests, which have no content record yet.
  entityId       String?
  kind           SubmissionKind
  status         SubmissionStatus  @default(PENDING)
  title          String
  /// Proposed values for UPDATE, the requested account details for
  /// ACCESS_REQUEST, and a snapshot for CREATE.
  payload        Json?
  /// Field-by-field description of what changes, built at submit time.
  changes        Json?
  /// Message from the person submitting.
  note           String?
  /// Reviewer's reason, shown back to the submitter.
  reviewNote     String?
  submittedById  String?
  reviewedById   String?
  submittedAt    DateTime          @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy  User?        @relation("SubmissionAuthor", fields: [submittedById], references: [id])
  reviewedBy   User?        @relation("SubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status, submittedAt])
  @@index([entityType, entityId])
  @@index([submittedById, status])
  @@index([deletedAt])
  @@map("content_submissions")
}

// -----------------------------------------------------------------------------
// Media library
// -----------------------------------------------------------------------------

model MediaFolder {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children     MediaFolder[] @relation("FolderTree")
  assets       MediaAsset[]

  @@index([organizationId, parentId])
  @@index([deletedAt])
  @@map("media_folders")
}

model MediaAsset {
  id             String    @id @default(cuid())
  organizationId String
  folderId       String?
  type           MediaType
  filename       String
  originalName   String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  url            String
  width          Int?
  height         Int?
  durationSec    Int?
  alt            String?
  title          String?
  checksum       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       MediaFolder?       @relation(fields: [folderId], references: [id])
  versions     MediaAssetVersion[]
  tags         MediaAssetTag[]

  @@index([organizationId, type])
  @@index([folderId])
  @@index([originalName])
  @@index([deletedAt])
  @@map("media_assets")
}

model MediaAssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  version   Int
  storageKey String
  url       String
  sizeBytes Int
  mimeType  String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@index([deletedAt])
  @@map("media_asset_versions")
}

model MediaAssetTag {
  id        String   @id @default(cuid())
  assetId   String
  tag       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, tag])
  @@index([tag])
  @@index([deletedAt])
  @@map("media_asset_tags")
}

