// =============================================================================
// Prowin REOS — Prisma Schema (Phase 0 Foundation)
// Multi-tenant Real Estate Operating System
// Soft delete: deletedAt | Every tenant row: organizationId
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum PropertySource {
  MANUAL
  LEADRAT
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  EXPIRED
}

/// Publish / inventory status (our workflow). Commercial lifecycle uses constructionStatus string from Reelly.
enum CompletionStatus {
  READY
  OFF_PLAN
  UNDER_CONSTRUCTION
}

/// Reelly furnishing values preserved as enum where stable; UNKNOWN for manual blanks.
enum FurnishingStatus {
  YES
  NO
  SEMI_FURNISHED
  ONLY_KITCHEN
  OPTIONAL_FURNISHED
  NO_INFORMATION
  FURNISHED
  UNFURNISHED
  NOT_SPECIFIED
}

enum VirtualTourType {
  TOUR_360
  VIDEO
  LIVE
}

enum PropertySyncStatus {
  IDLE
  PENDING
  SYNCING
  SYNCED
  FAILED
  STALE
  PROVIDER_DELETED
  NOT_REQUIRED
}

enum GalleryKind {
  COVER
  LOBBY
  INTERIOR
  ARCHITECTURE
  GENERAL_PLAN
  UNIT_LAYOUT
  OTHER
}

enum DocumentKind {
  FLOOR_PLAN
  BROCHURE
  CONTRACT
  FACTSHEET
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
  FLOOR_PLAN
  BROCHURE
  LOGO
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  MEETING_SCHEDULED
  SITE_VISIT
  CLOSED
  LOST
}

enum CrmSyncStatus {
  PENDING
  SYNCED
  FAILED
  NOT_REQUIRED
}

enum WorkflowState {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ContentEntityType {
  BLOG_POST
  PAGE
  HOMEPAGE
  LANDING_PAGE
  PROPERTY
  AGENT_PROFILE
  AGENT_ACCOUNT
}

enum SubmissionKind {
  /** A record that only becomes public once approved. */
  CREATE
  /** Changes held against an already-live record. */
  UPDATE
  /** Someone asking for portal access. */
  ACCESS_REQUEST
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PageKind {
  STATIC
  HOMEPAGE
  LANDING
}

enum SectionType {
  HERO
  SEARCH
  TRUST_STRIP
  FEATURED_PROJECTS
  DEVELOPERS
  COMMUNITIES
  AREAS
  PATHS
  TESTIMONIALS
  STATISTICS
  BANNER
  CTA
  TEAM
  INSIGHT
  FAQ
  CUSTOM
  FORM
  SEO_LINKS
  RICH_TEXT
  GALLERY
  VIDEO
  MAP
}

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  NUMBER
  DATE
  HIDDEN
  FILE
}

enum NotificationType {
  NEW_LEAD
  CRM_SYNC_FAILED
  PROPERTY_SYNC_FAILED
  PROPERTY_PUBLISHED
  PROPERTY_EXPIRED
  BLOG_SCHEDULED
  WORKFLOW_SUBMITTED
  WORKFLOW_APPROVED
  WORKFLOW_REJECTED
  SYSTEM_ALERT
}

enum SyncJobType {
  PROPERTY_IMPORT
  PROPERTY_UPDATE
  PROPERTY_DELETE
  BULK_IMPORT
  BULK_UPDATE
  BULK_PUBLISH
  BULK_ARCHIVE
  BULK_DELETE
  CRM_LEAD_PUSH
  CRM_LEAD_RETRY
  FULL_SYNC
  BLOG_IMPORT
  API_IMPORT
}

enum ApiSourceTarget {
  BLOG
  INSIGHT
  FAQ
  TESTIMONIAL
  DEVELOPER
  AREA
  COMMUNITY
  AGENT
  AMENITY
  PROPERTY
  CATEGORY
  PAGE
  LANDING_PAGE
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  CANCELLED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PROPERTY_VIEW
  SEARCH
  FILTER
  LEAD_SUBMIT
  BROCHURE_DOWNLOAD
  WHATSAPP_CLICK
  CALL_CLICK
  MEETING
  SITE_VISIT
  CONVERSION
  FAVOURITE
  COMPARE
  SHARE
  FORM_START
  FORM_SUBMIT
}

// -----------------------------------------------------------------------------
// Multi-tenant root
// -----------------------------------------------------------------------------

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  legalName        String?
  email            String?
  phone            String?
  whatsapp         String?
  address          String?
  city             String?
  country          String?  @default("AE")
  logoMediaId      String?
  faviconMediaId   String?
  primaryColor     String?  @default("#A01919")
  secondaryColor   String?  @default("#b08948")
  domain           String?
  timezone         String   @default("Asia/Dubai")
  defaultCurrency  String   @default("AED")
  isActive         Boolean  @default(true)
  settings         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  users              User[]
  roles              Role[]
  properties         Property[]
  developers         Developer[]
  countries          Country[]
  cities             City[]
  areas              Area[]
  communities        Community[]
  amenities          Amenity[]
  features           Feature[]
  banks              Bank[]
  categories         PropertyCategory[]
  propertyTypes      PropertyType[]
  agents             Agent[]
  leads              Lead[]
  pages              Page[]
  landingPages       LandingPage[]
  blogPosts          BlogPost[]
  blogCategories     BlogCategory[]
  tags               Tag[]
  testimonials       Testimonial[]
  faqs               Faq[]
  forms              Form[]
  mediaFolders       MediaFolder[]
  mediaAssets        MediaAsset[]
  menus              Menu[]
  websiteSettings    WebsiteSetting[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  syncJobs           SyncJob[]
  providerCredentials ProviderCredential[]
  savedSearches      SavedSearch[]
  savedPropertyFilters SavedPropertyFilter[]
  analyticsEvents    AnalyticsEvent[]
  nearbyPlaces       NearbyPlace[]
  apiSources         ApiSource[]
  contentSubmissions ContentSubmission[]

  @@index([slug])
  @@index([domain])
  @@index([deletedAt])
  @@map("organizations")
}

/** Saved HTTP API connections — fetch any JSON API into site content. */
model ApiSource {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  target         ApiSourceTarget
  method         String          @default("GET")
  url            String
  /** Extra request headers as { key: value } */
  headers        Json?
  /** none | bearer | basic */
  authType       String          @default("none")
  authValue      String?
  /** Dot path to the items array, e.g. data.posts — empty = root array or auto-detect */
  itemsPath      String?
  /** Map of destination field → source JSON path, e.g. { "title": "name", "content": "body.html" } */
  fieldMap       Json
  autoPublish    Boolean         @default(true)
  enabled        Boolean         @default(true)
  lastFetchedAt  DateTime?
  lastResult     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
  @@index([organizationId, target])
  @@index([deletedAt])
  @@map("api_sources")
}

model ProviderCredential {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  label          String?
  credentials    Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, label])
  @@index([organizationId, provider, isActive])
  @@index([deletedAt])
  @@map("provider_credentials")
}

// -----------------------------------------------------------------------------
// Better Auth + RBAC
// -----------------------------------------------------------------------------

model User {
  id             String     @id @default(cuid())
  organizationId String?
  name           String
  email          String
  emailVerified  Boolean    @default(false)
  image          String?
  phone          String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  sessions     Session[]
  accounts     Account[]
  userRoles    UserRole[]
  assignedLeads Lead[]       @relation("LeadAssignee")
  leadNotes    LeadNote[]
  activityLogs ActivityLog[]
  notifications Notification[]
  favourites   Favourite[]
  savedSearches SavedSearch[]
  workflowActions WorkflowAction[]
  agentProfile Agent?
  submissions  ContentSubmission[] @relation("SubmissionAuthor")
  reviewedSubmissions ContentSubmission[] @relation("SubmissionReviewer")

  @@unique([email])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  slug           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization    Organization?   @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  rolePermissions RolePermission[]

  @@index([group])
  @@index([deletedAt])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([deletedAt])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// Geo hierarchy
// -----------------------------------------------------------------------------

model Country {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isoCode        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cities       City[]
  properties   Property[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@map("countries")
}

model City {
  id             String   @id @default(cuid())
  organizationId String
  countryId      String
  name           String
  slug           String
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country      Country      @relation(fields: [countryId], references: [id])
  areas        Area[]
  properties   Property[]

  @@unique([organizationId, slug])
  @@index([organizationId, countryId])
  @@index([deletedAt])
  @@map("cities")
}

model Area {
  id                  String   @id @default(cuid())
  organizationId      String
  cityId              String
  name                String
  slug                String
  shortDescription    String?
  description         String?  @db.Text
  latitude            Float?
  longitude           Float?
  investmentHighlights String? @db.Text
  rentalYield         Decimal? @db.Decimal(5, 2)
  averageRoi          Decimal? @db.Decimal(5, 2)
  metaTitle           String?
  metaDescription     String?
  canonicalUrl        String?
  ogImageId           String?
  isPublished         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  city         City          @relation(fields: [cityId], references: [id])
  communities  Community[]
  properties   Property[]
  gallery      AreaImage[]
  nearbyPlaces NearbyPlace[] @relation("AreaNearby")
  faqs         Faq[]

  @@unique([organizationId, slug])
  @@index([organizationId, cityId])
  @@index([isPublished, deletedAt])
  @@map("areas")
}

model AreaImage {
  id        String   @id @default(cuid())
  areaId    String
  mediaId   String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId, sortOrder])
  @@index([deletedAt])
  @@map("area_images")
}

model Community {
  id                  String   @id @default(cuid())
  organizationId      String
  areaId              String
  name                String
  slug                String
  shortDescription    String?
  description         String?  @db.Text
  latitude            Float?
  longitude           Float?
  investmentHighlights String? @db.Text
  rentalYield         Decimal? @db.Decimal(5, 2)
  averageRoi          Decimal? @db.Decimal(5, 2)
  metaTitle           String?
  metaDescription     String?
  canonicalUrl        String?
  ogImageId           String?
  isPublished         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area         Area         @relation(fields: [areaId], references: [id])
  properties   Property[]
  faqs         Faq[]

  @@unique([organizationId, slug])
  @@index([organizationId, areaId])
  @@index([isPublished, deletedAt])
  @@map("communities")
}

model NearbyPlace {
  id             String   @id @default(cuid())
  organizationId String
  areaId         String?
  name           String
  category       String
  latitude       Float?
  longitude      Float?
  distanceKm     Decimal? @db.Decimal(8, 2)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area         Area?        @relation("AreaNearby", fields: [areaId], references: [id])

  @@index([organizationId, category])
  @@index([areaId])
  @@index([deletedAt])
  @@map("nearby_places")
}

// -----------------------------------------------------------------------------
// Developers & taxonomy
// -----------------------------------------------------------------------------

model Developer {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  slug             String
  logoMediaId      String?
  coverMediaId     String?
  shortDescription String?
  description      String?  @db.Text
  website          String?
  email            String?
  phone            String?
  logoUrl          String?
  foundedYear      Int?
  headquarters     String?
  investmentHighlights String? @db.Text
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  isPublished      Boolean  @default(true)
  /// Lower = properties appear earlier on public listings (9999 = unordered)
  listPriority     Int      @default(9999)
  externalId       String?
  source           PropertySource @default(MANUAL)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties   Property[]
  faqs         Faq[]
  gallery      DeveloperImage[]

  @@unique([organizationId, slug])
  @@index([organizationId, isPublished])
  @@index([organizationId, listPriority])
  @@index([externalId, source])
  @@index([deletedAt])
  @@map("developers")
}

/// Public-facing sales consultant / listing agent (catalog profile)
model Agent {
  id               String   @id @default(cuid())
  organizationId   String
  /// Optional link to a login User for CRM assignment
  userId           String?  @unique
  name             String
  slug             String
  email            String?
  phone            String?
  whatsapp         String?
  photoMediaId     String?
  photoUrl         String?
  title            String?
  bio              String?  @db.Text
  specialties      String[] @default([])
  languages        String[] @default([])
  reraNumber       String?
  yearsExperience  Int?
  serviceAreas     String[] @default([])
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  sortOrder        Int      @default(0)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties   Property[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive, deletedAt])
  @@index([organizationId, isFeatured])
  @@index([deletedAt])
  @@map("agents")
}

model DeveloperImage {
  id          String   @id @default(cuid())
  developerId String
  mediaId     String
  alt         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId, sortOrder])
  @@index([deletedAt])
  @@map("developer_images")
}

model PropertyCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties   Property[]

  @@unique([organizationId, slug])
  @@index([deletedAt])
  @@map("property_categories")
}

model PropertyType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties   Property[]

  @@unique([organizationId, slug])
  @@index([deletedAt])
  @@map("property_types")
}

model Amenity {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  icon           String?
  iconUrl        String?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyAmenities PropertyAmenity[]

  @@unique([organizationId, slug])
  @@index([organizationId, externalId])
  @@index([deletedAt])
  @@map("amenities")
}

model Feature {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyFeatures PropertyFeature[]

  @@unique([organizationId, slug])
  @@index([deletedAt])
  @@map("features")
}

model Bank {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  logoUrl        String?
  website        String?
  externalId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyBanks  PropertyBank[]

  @@unique([organizationId, slug])
  @@index([organizationId, externalId])
  @@index([deletedAt])
  @@map("banks")
}

// -----------------------------------------------------------------------------
// Properties — core + normalized children (Reelly Project aligned)
// -----------------------------------------------------------------------------

model Property {
  id                  String           @id @default(cuid())
  organizationId      String
  name                String
  slug                String
  description         String?          @db.Text
  shortDescription    String?          @db.Text
  status              PropertyStatus   @default(PUBLISHED)
  source              PropertySource   @default(MANUAL)
  /// LeadRat Project GUID when source = LEADRAT
  leadratProjectId    String?
  /// Optional upstream Reelly id if LeadRat ever exposes it
  reellyProjectId     String?
  reellySlug          String?
  /// Reelly construction_status (snake_case label preserved as string)
  constructionStatus  String?
  /// Reelly sale_status
  saleStatus          String?
  /// Mapped READY / OFF_PLAN / UNDER_CONSTRUCTION when derivable
  completionStatus    CompletionStatus?
  completionLabel     String?
  possessionDate      DateTime?
  constructionStartDate DateTime?
  constructionEndDate DateTime?
  developerId         String?
  agentId             String?
  communityId         String?
  areaId              String?
  cityId              String?
  countryId           String?
  categoryId          String?
  propertyTypeId      String?
  minPrice            Decimal?         @db.Decimal(14, 2)
  maxPrice            Decimal?         @db.Decimal(14, 2)
  currency            String           @default("AED")
  minSize             Decimal?         @db.Decimal(12, 2)
  maxSize             Decimal?         @db.Decimal(12, 2)
  areaUnit            String           @default("sqft")
  furnishing          FurnishingStatus @default(NOT_SPECIFIED)
  hasEscrow           Boolean          @default(false)
  escrowNumber        String?
  postHandover        Boolean          @default(false)
  serviceCharge       String?
  depositDescription  String?          @db.Text
  brand               String?
  managingCompany     String?
  readinessProgress   Decimal?         @db.Decimal(5, 2)
  website             String?
  unitsCount          Int?
  buildingCount       Int?
  isFeatured          Boolean          @default(false)
  isVerified          Boolean          @default(false)
  isPartnerProject    Boolean          @default(false)
  /// Broker cashback offered on this project, as a percentage (e.g. 1.00 = 1%)
  cashbackPercent     Decimal?         @db.Decimal(5, 2)
  /// Set when a 360 tour, video tour or live viewing is available
  virtualTour         VirtualTourType?
  /// Lower = shown earlier on public listings (priority developers / projects)
  listPriority        Int              @default(9999)
  /// Extended manual-upload fields (NRI-style government / plot / references)
  details             Json?
  /// Set only for listings that came through the agent portal; null means the
  /// record is managed directly by staff and needs no approval to stay live.
  workflowState       WorkflowState?
  publishedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  developer    Developer?        @relation(fields: [developerId], references: [id])
  agent        Agent?            @relation(fields: [agentId], references: [id])
  community    Community?        @relation(fields: [communityId], references: [id])
  area         Area?             @relation(fields: [areaId], references: [id])
  city         City?             @relation(fields: [cityId], references: [id])
  country      Country?          @relation(fields: [countryId], references: [id])
  category     PropertyCategory? @relation(fields: [categoryId], references: [id])
