# =============================================================================
# Prowin REOS â€” Environment Template (Phase 0)
# Copy to .env.local and fill values. Never commit secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Default tenant (seed)
SEED_ORG_NAME="Prowin Properties"
SEED_ORG_SLUG="prowin"
SEED_ADMIN_EMAIL="admin@prowinproperties.com"
SEED_ADMIN_PASSWORD="change-me-immediately"
SEED_ADMIN_NAME="Prowin Admin"

# Property providers (server-only — never NEXT_PUBLIC_)
# Inventory: LeadRat Off Plan public listings (images + prices)
LEADRAT_OFFPLAN_API_BASE_URL="https://projectsapi.leadrat.com/api/public"
LEADRAT_OFFPLAN_API_KEY=""
LEADRAT_OFFPLAN_ENABLED="false"
# Auto-pull inventory when admin is used (default on). Interval in minutes.
LEADRAT_AUTO_SYNC="true"
LEADRAT_AUTO_SYNC_MINUTES="30"

# CRM lead push only (Enterprise API — optional, separate from inventory)
LEADRAT_API_BASE_URL="https://connect.leadrat.com/api/v1"
LEADRAT_API_KEY=""
LEADRAT_SECRET_KEY=""
LEADRAT_TENANT=""
LEADRAT_ENABLED="false"

# Optional defaults for quick Blog fetch (Admin → API Fetch).
# Prefer saving reusable sources in Admin → API Fetch → Custom API sources.
BLOG_API_ENABLED="false"
BLOG_API_PROVIDER="wordpress"
BLOG_API_BASE_URL=""
BLOG_API_KEY=""
BLOG_API_AUTO_PUBLISH="true"

# Deprecated â€” kept for reference only; not used by REOS
# REELLY_API_KEY=""
# REELLY_API_BASE_URL=""

# CRM â€” LeadRat lead push (same credentials as inventory)
# LEADRAT_* above also power CrmProvider

# Maps / Google Business reviews (Places API — Place Details)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server-only key preferred for reviews (Places API enabled). Falls back to NEXT_PUBLIC_ key.
GOOGLE_PLACES_API_KEY=""
# From Google Place ID Finder: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACE_ID=""
# Optional if PLACE_ID unset — used by Find Place From Text
# GOOGLE_PLACE_QUERY="Prowin Properties Icon Tower Barsha Heights Dubai"

# Media — Vercel Blob (required for uploads on the hosted site)
# Create a Blob store on the Vercel project; the token is injected automatically.
BLOB_READ_WRITE_TOKEN=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Email — Google Workspace (recommended) or Resend
# Provider auto-detects: SMTP_USER+SMTP_PASS → gsuite, else RESEND_API_KEY → resend
EMAIL_PROVIDER="gsuite"
EMAIL_FROM="Prowin Properties <tech@prowinproperties.com>"

# Google Workspace SMTP (smtp.gmail.com)
# 1) Use Workspace mailbox tech@prowinproperties.com
# 2) Enable 2-Step Verification for that user
# 3) Create an App Password: https://myaccount.google.com/apppasswords
# 4) Paste the 16-character App Password into SMTP_PASS (no spaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tech@prowinproperties.com"
SMTP_PASS=""

# Stature one-pager leads (Hostinger email)
# Create a mailbox in Hostinger, then:
#   EMAIL_PROVIDER="smtp"
#   SMTP_HOST="smtp.hostinger.com"
#   SMTP_PORT="465"
#   SMTP_SECURE="true"
#   SMTP_USER="your-mailbox@yourdomain.com"
#   SMTP_PASS="mailbox-password"
#   EMAIL_FROM="Stature Properties <your-mailbox@yourdomain.com>"
#   LEAD_TO="support@staturegroup.in"

# =============================================================================
# HelloLeads CRM (primary lead destination)
# In HelloLeads web app: Settings → Web Form Integration → Website Integration
# Copy the API key (Bearer token) and the list key for website / ads enquiries.
# Leave keys empty locally until you paste them; the form still works via mailto.
# =============================================================================
HELLOLEADS_ENABLED="true"
HELLOLEADS_API_URL="https://app.helloleads.io/index.php/source/api/addlead"
HELLOLEADS_API_KEY=""
HELLOLEADS_LIST_KEY=""

# Optional ads measurement (leave blank until you have IDs)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_TAG_ID=""
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=""


# Optional fallback (Resend)
# RESEND_API_KEY=""

# =============================================================================
# Original site cutover (https://www.prowinproperties.com)
# When DNS points this Next.js app at the live domain, set these on the
# Vercel Production environment (not Preview):
#
#   NEXT_PUBLIC_APP_URL="https://www.prowinproperties.com"
#   BETTER_AUTH_URL="https://www.prowinproperties.com"
#
# Invite and forgot-password emails use NEXT_PUBLIC_APP_URL for login/reset
# links. Also set SMTP_USER + SMTP_PASS (Workspace App Password) and EMAIL_FROM.
# Extra auth origins (comma-separated) if www and apex both serve the app:
# AUTH_TRUSTED_ORIGINS="https://prowinproperties.com"
#
# Then: npm run check:cutover
# Admin → Settings also shows the same readiness flags.
# =============================================================================

# Cron / background jobs
CRON_SECRET=""

# Analytics (future)
# GOOGLE_ADS_CUSTOMER_ID=""
# META_ADS_ACCOUNT_ID=""

